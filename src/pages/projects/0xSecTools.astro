---
import Layout from "../../layouts/Layout.astro";
import NavBar from "../../components/NavBar.astro";
import "../../styles/global.css";
import BottomBar from "../../components/BottomBar.astro";
import { Separator } from "../../components/ui/separator.tsx";
---

<Layout>
    <div class="h-screen w-full flex flex-col overflow-hidden">
        <header class="w-full z-10 bg-inherit flex-shrink-0">
            <NavBar title="portfolio/projects/CCApp" button="projects" />
        </header>
        <main
            class="flex-1 w-full flex flex-col items-center px-4 md:px-0 overflow-y-auto"
        >
            <div class="pt-10 w-full md:w-2/5">
                <div class="font-mono text-sm">
                    <p class="font-[900] text-lg"># 0xSecTools</p>
                    <Separator />
                    <p class="mt-2 mb-2">
                        0xSecTools is a small, growing repository where I
                        document cybersecurity concepts and vulnerabilities as I
                        learn them — currently starting with Wi-Fi security. The
                        goal is a personal knowledge base I can keep building on
                        and reference over time.
                    </p>
                    <p class="mb-2">
                        Each entry breaks down a specific attack or concept: how
                        it works, why it's possible, and how to defend against
                        it. It's less about writing exploits and more about
                        understanding the underlying weaknesses, so the notes
                        stay practical and easy to revisit later.
                    </p>
                    <Separator />
                    <p class="mt-2 mb-1 text-[#7AA2F7] font-[900]">status.</p>
                    <p class="mb-2">
                        work in progress — new topics get added as I learn them.
                    </p>
                    <Separator />
                    <p class="mt-2 mb-1 text-[#7AA2F7] font-[900]">covers.</p>
                    <ul class="list-disc list-inside mb-2 space-y-1">
                        <li>Wi-Fi security fundamentals</li>
                        <li>common attack vectors</li>
                        <li>basic mitigation strategies</li>
                    </ul>
                    <Separator />
                </div>
            </div>
        </main>
        <footer
            class="w-full z-10 bg-inherit py-10 flex justify-center flex-shrink-0"
        >
            <BottomBar />
        </footer>
    </div>
</Layout>
